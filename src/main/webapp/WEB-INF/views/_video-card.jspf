<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="jakarta.tags.functions" prefix="fn" %>
<%-- Dùng bên trong <c:forEach var="v">. Đặt <c:set var="showActions" value="true"/> trước để hiện Sửa/Xóa. --%>
<c:choose>
  <c:when test="${not empty v.poster and fn:startsWith(v.poster, 'http')}"><c:set var="thumb" value="${v.poster}"/></c:when>
  <c:when test="${not empty v.poster}"><c:url var="thumb" value="/image"><c:param name="fname" value="${v.poster}"/></c:url></c:when>
  <c:when test="${not empty v.youtubeId}"><c:set var="thumb" value="https://img.youtube.com/vi/${v.youtubeId}/hqdefault.jpg"/></c:when>
  <c:otherwise><c:set var="thumb" value=""/></c:otherwise>
</c:choose>
<c:url var="watchUrl" value="/video/watch"><c:param name="id" value="${v.videoId}"/></c:url>
<article class="vcard">
  <a class="vthumb" href="${watchUrl}" tabindex="-1" aria-hidden="true">
    <c:choose>
      <c:when test="${not empty thumb}"><img src="<c:out value='${thumb}'/>" alt="" loading="lazy"></c:when>
      <c:otherwise><span class="noposter">▶</span></c:otherwise>
    </c:choose>
  </a>
  <div class="vbody">
    <h3 class="vtitle"><a href="${watchUrl}"><c:out value="${v.title}"/></a></h3>
    <p class="muted vmeta">
      <c:if test="${not showActions and v.user != null}"><c:out value="${v.user.fullName}"/> · </c:if>${v.views} lượt xem
      <c:if test="${showActions and not v.active}"> <span class="badge">Đang ẩn</span></c:if>
    </p>
    <c:if test="${showActions}">
      <div class="vactions">
        <a href="<c:url value='/video/edit'><c:param name='id' value='${v.videoId}'/></c:url>">Sửa</a>
        <form action="${pageContext.request.contextPath}/video/delete" method="post"
              onsubmit="return confirm('Xóa video này?');">
          <input type="hidden" name="id" value="<c:out value='${v.videoId}'/>">
          <button type="submit" class="linkbtn">Xóa</button>
        </form>
      </div>
    </c:if>
  </div>
</article>
