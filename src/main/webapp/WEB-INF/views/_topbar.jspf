<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/static/style.css">
<nav class="nav">
  <strong>JPA Shopping</strong>
  <c:if test="${sessionScope.account.roleid == 1}">
    <a href="${pageContext.request.contextPath}/admin/home">Trang quản trị</a>
    <a href="${pageContext.request.contextPath}/admin/category/list">Danh mục</a>
    <a href="${pageContext.request.contextPath}/admin/category/add">Thêm danh mục</a>
  </c:if>
  <span class="grow"></span>
  <c:choose>
    <c:when test="${sessionScope.account == null}">
      <a href="${pageContext.request.contextPath}/login">Đăng nhập</a>
      <a href="${pageContext.request.contextPath}/register">Đăng ký</a>
    </c:when>
    <c:otherwise>
      <span><c:out value="${sessionScope.account.fullName}"/></span>
      <a href="${pageContext.request.contextPath}/logout">Đăng xuất</a>
    </c:otherwise>
  </c:choose>
</nav>
